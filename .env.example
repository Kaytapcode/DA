# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-strong
# >= 32 chars, e.g. `openssl rand -base64 48`
JWT_KEY=change-me-at-least-32-characters-long-random
# shared secret for /api/internal/** calls between services
INTERNAL_API_KEY=change-me-random
# browser origin of the deployed FE (CORS)
CORS_ORIGIN=http://localhost:5173
# OpenRouter key for AI quiz generation (optional; can also be set via SysAdmin AI-keys page)
OPENROUTER_API_KEY=
# Optional model overrides (defaults: stepfun/step-3.5-flash, fallback meta-llama/llama-3.1-8b-instruct)
# OpenRouter__Model=
# OpenRouter__FallbackModel=
# Only for `--profile https`
DOMAIN=lumina.example.com
