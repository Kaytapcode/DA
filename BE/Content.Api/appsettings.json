{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Jwt": {
    "Key": "",
    "Issuer": "QuizLMS.AuthService",
    "Audience": "QuizLMS.All"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Identity": { "InternalBaseUrl": "http://localhost:5001" },
  "Organization": { "InternalBaseUrl": "http://localhost:5002" },
  "Internal": { "ApiKey": "" },
  "Database": { "AutoMigrate": true },
  "Cors": { "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000", "http://localhost:5000" ] },

  "Storage": {
    "Provider": "Local",
    "LocalPath": "./uploads/documents",
    "MaxFileSizeBytes": 209715200,
    "AllowedTypes": [ "application/pdf", "image/png", "image/jpeg", "text/plain" ]
  }
}
