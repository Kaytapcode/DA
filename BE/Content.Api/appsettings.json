{
  "ConnectionStrings": {
    "DefaultConnection": "SET_VIA_USER_SECRETS: dotnet user-secrets set \"ConnectionStrings:DefaultConnection\" \"Host=...;Database=...;Username=...;Password=...\""
  },

  "Jwt": {
    "Key": "SET_VIA_USER_SECRETS: dotnet user-secrets set \"Jwt:Key\" \"<32-byte-random-base64>\"",
    "Issuer": "QuizLMS.AuthService",
    "Audience": "QuizLMS.All"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Storage": {
    "Provider": "Local",
    "LocalPath": "./uploads/documents",
    "MaxFileSizeBytes": 52428800,
    "AllowedTypes": [ "application/pdf", "image/png", "image/jpeg", "text/plain" ]
  }
}
